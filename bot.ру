async def purchase_tag(query, user_id: int, tag_id: int, lang: str):
    with get_db_connection() as conn:
        c = conn.cursor()
        c.execute('SELECT tag, price, seller_id FROM shop_tags WHERE id = ? AND status = "available"', (tag_id,))
        row = c.fetchone()
        
        if not row:
            await query.answer("❌ Тег не найден или уже продан", show_alert=True)
            return
        
        tag, price, seller_id = row
        user = get_user(user_id)
        
        if user['balance'] < price:
            await query.answer(f"❌ Недостаточно средств. Баланс: ${user['balance']:.2f}", show_alert=True)
            return
        
        c.execute('''UPDATE shop_tags SET status = 'sold', sold_to = ?, sold_at = ? 
                    WHERE id = ?''', (user_id, datetime.datetime.now().isoformat(), tag_id))
        c.execute('UPDATE users SET balance = balance - ? WHERE user_id = ?', (price, user_id))
        c.execute('UPDATE users SET balance = balance + ? WHERE user_id = ?', (price, seller_id))
        conn.commit()
    
    await query.edit_message_caption(
        caption=f"✅ <b>ТЕГ КУПЛЕН!</b>\n\n@{tag}\n\nСвяжитесь с продавцом для передачи тега.",
        parse_mode=ParseMode.HTML,
        reply_markup=get_back_keyboard('shop', lang)
    )
    
    try:
        await context.bot.send_message(seller_id, f"💰 Ваш тег @{tag} куплен за ${price:.2f}!\nПокупатель: @{user['username'] or user_id}")
    except:
        pass

