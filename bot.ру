async def ban_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    if not context.args:
        await update.message.reply_text("/ban ID")
        return
    user_id = int(context.args[0])
    with get_db_connection() as conn:
        conn.execute('UPDATE users SET is_banned = 1 WHERE user_id = ?', (user_id,))
        conn.commit()
    await update.message.reply_text(f"✅ {user_id} забанен")

async def unban_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    if not context.args:
        await update.message.reply_text("/unban ID")
        return
    user_id = int(context.args[0])
    with get_db_connection() as conn:
        conn.execute('UPDATE users SET is_banned = 0 WHERE user_id = ?', (user_id,))
        conn.commit()
    await update.message.reply_text(f"✅ {user_id} разбанен")

async def premium_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        await update.message.reply_text("❌ Нет прав")
        return
    if len(context.args) < 2:
        await update.message.reply_text("/premium ID дни")
        return
    user_id = int(context.args[0])
    days = int(context.args[1])
    until = (datetime.datetime.now() + datetime.timedelta(days=days)).strftime("%Y-%m-%d")
    with get_db_connection() as conn:
        conn.execute('''UPDATE users SET premium_level = 1, premium_until = ? 
                       WHERE user_id = ?''', (until, user_id))
        conn.commit()
    await update.message.reply_text(f"✅ Premium {days} дн. выдан пользователю {user_id}")

async def reset_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    if not context.args:
        await update.message.reply_text("/reset ID")
        return
    user_id = int(context.args[0])
    user = get_user(user_id)
    base = FREE_REQUESTS_PER_DAY + (user['referral_bonus'] or 0)
    with get_db_connection() as conn:
        conn.execute('UPDATE users SET daily_requests = ? WHERE user_id = ?', (base, user_id))
        conn.commit()
    await update.message.reply_text(f"✅ Лимит {user_id} сброшен")

async def broadcast_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    if not context.args:
        await update.message.reply_text("/broadcast текст")
        return
    text = " ".join(context.args)
    with get_db_connection() as conn:
        users = conn.execute('SELECT user_id FROM users WHERE is_banned = 0').fetchall()
    sent = 0
    for (user_id,) in users:
        try:
            await context.bot.send_message(user_id, f"📢 <b>РАССЫЛКА</b>\n\n{text}", parse_mode=ParseMode.HTML)
            sent += 1
            await asyncio.sleep(0.05)
        except:
            pass
    await update.message.reply_text(f"✅ Отправлено: {sent}/{len(users)}")

