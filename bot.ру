# ==================== ОБРАБОТЧИКИ СООБЩЕНИЙ ====================
async def handle_trap_input(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.user_data.get('awaiting_trap'):
        return
    
    user_id = update.effective_user.id
    user = get_user(user_id)
    lang = user['language']
    t = LANG[lang]
    tag = update.message.text.strip().lower().replace('@', '')
    
    if not re.match(r'^[a-zA-Z][a-zA-Z0-9_]{3,31}$', tag):
        await update.message.reply_text(t['invalid_format'])
        return
    
    with get_db_connection() as conn:
        c = conn.cursor()
        c.execute('SELECT COUNT(*) FROM traps WHERE user_id = ?', (user_id,))
        count = c.fetchone()[0]
    
    if count >= 1:
        await update.message.reply_text(t['trap_limit'])
        context.user_data['awaiting_trap'] = False
        return
    
    with get_db_connection() as conn:
        conn.execute('INSERT INTO traps (user_id, tag) VALUES (?, ?)', (user_id, tag))
        conn.commit()
    
    await update.message.reply_text(t['trap_added'].format(tag=tag))
    context.user_data['awaiting_trap'] = False

async def handle_ticket(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.user_data.get('awaiting_ticket'):
        return
    
    user_id = update.effective_user.id
    username = update.effective_user.username or "нет"
    question = update.message.text
    user = get_user(user_id)
    lang = user['language']
    t = LANG[lang]
    
    with get_db_connection() as conn:
        conn.execute('''INSERT INTO tickets (user_id, username, question) 
                       VALUES (?, ?, ?)''', (user_id, username, question))
        conn.commit()
    
    await update.message.reply_text(t['ticket_sent'])
    await context.bot.send_message(
        ADMIN_ID,
        f"📨 Тикет от @{username} (ID: {user_id})\n💬 {question}"
    )
    
    context.user_data['awaiting_ticket'] = False

async def set_header_image(update: Update, context: ContextTypes.DEFAULT_TYPE):
