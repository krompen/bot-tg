def get_cached_free_tag(length: Optional[int] = None) -> Optional[Dict]:
    with get_db_connection() as conn:
        c = conn.cursor()
        if length:
            c.execute('''SELECT tag, length, stars FROM free_tags_cache 
                        WHERE length = ? ORDER BY stars DESC LIMIT 1''', (length,))
        else:
            c.execute('''SELECT tag, length, stars FROM free_tags_cache 
                        ORDER BY stars DESC LIMIT 1''')
        row = c.fetchone()
        if row:
            return {'tag': row[0], 'length': row[1], 'stars': row[2]}
        return None

