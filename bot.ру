            text,
            parse_mode=ParseMode.HTML,
            reply_markup=InlineKeyboardMarkup([
                [InlineKeyboardButton(f"🔎 {length} БУКВ", callback_data=f'find_{length}')],
                [InlineKeyboardButton(LANG[lang]['back'], callback_data='back_main')]
            ]),
            disable_web_page_preview=True
        )
        return
    
    # Живой поиск
    found = False
    attempts = 0
    tag = ""
    stars = 0
    readable = 0
    
    if not telethon_client.is_connected():
        await telethon_client.connect()
    
    while not found and attempts < 100:
        tag = generate_tag(length)
        free = await check_username_free(telethon_client, tag)
        attempts += 1
        
        if free:
            stars, readable = calculate_tag_score(tag)
            if stars >= 20 or attempts > 50:
                found = True
                add_free_tag_to_cache(tag, length, stars, readable)
    
    if found:
        save_found_tag(user_id, tag, length, stars, readable)
        text = f"<b>✅ НИК НАЙДЕН!</b>\n\n@{tag}\n{length} букв\n⭐ {stars} ⭐\n✅ Свободен\n\n🔗 t.me/{tag}"
    else:
        text = f"<b>❌ Ничего не найдено</b>\n\nПопробуй еще раз!"
    
    await query.edit_message_text(
        text,
        parse_mode=ParseMode.HTML,
        reply_markup=InlineKeyboardMarkup([
            [InlineKeyboardButton(f"🔎 {length} БУКВ", callback_data=f'find_{length}')],
