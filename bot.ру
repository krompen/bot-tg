def calculate_tag_score(tag: str) -> Tuple[int, int]:
    """Возвращает (звёзды 0-200, читабельность 0-100)"""
    tag_lower = tag.lower()
    score = 50
    readable = 50
    
    vowel_count = sum(1 for c in tag_lower if c in VOWELS)
    cons_count = sum(1 for c in tag_lower if c in CONSONANTS)
    
    if vowel_count > 0 and cons_count > 0:
        ratio = vowel_count / cons_count
        if 0.4 <= ratio <= 0.8:
            readable += 20
            score += 30
        elif 0.3 <= ratio <= 1.0:
            readable += 10
            score += 15
    
    for pattern in BAD_PATTERNS:
        if pattern in tag_lower:
            readable -= 15
            score -= 20
    
    if re.search(r'(.)\1{2,}', tag_lower):
        readable -= 20
        score -= 25
    
    common_endings = ['er', 'or', 'ed', 'ing', 'us', 'um', 'ia', 'io', 'on', 'an', 'en', 'ov', 'in']
    for end in common_endings:
        if tag_lower.endswith(end):
            readable += 10
            score += 15
            break
    
    if tag_lower[0] in VOWELS and tag_lower[1] in CONSONANTS:
        readable += 5
        score += 8
    
    score = max(10, min(200, score))
    readable = max(10, min(100, readable))
    
    return score, readable

def generate_tag(length: int = 5) -> str:
    tag = ""
    for i in range(length):
        if i % 2 == 0:
            tag += random.choice(CONSONANTS)
        else:
            tag += random.choice(VOWELS)
    return tag

def generate_similar_tags(base: str, count: int = 10) -> List[str]:
    similar = set()
    base_lower = base.lower()
    
    variations = [
        base_lower + random.choice(CONSONANTS),
        base_lower + random.choice(VOWELS),
        base_lower + '_',
        base_lower + str(random.randint(1, 99)),
        random.choice(CONSONANTS) + base_lower,
        base_lower[:-1] + random.choice(CONSONANTS),
        base_lower[:-1] + random.choice(VOWELS),
        base_lower[0] + '_' + base_lower[1:],
    ]
    
    for v in variations:
        if 5 <= len(v) <= 15:
            similar.add(v)
    
    while len(similar) < count:
        similar.add(generate_tag(random.choice([5, 6])))
    
    return list(similar)[:count]

async def check_username_free(client: TelegramClient, tag: str) -> bool:
    try:
        await client.get_entity(f"@{tag}")
        return False
    except errors.UsernameNotOccupiedError:
        return True
    except errors.FloodWaitError as e:
        logger.warning(f"Flood wait: {e.seconds}s")
        await asyncio.sleep(e.seconds)
        return await check_username_free(client, tag)
    except Exception as e:
        logger.error(f"Error checking @{tag}: {e}")
        return False

