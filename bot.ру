    if not can_request:
        await query.edit_message_text(
            LANG[lang]['limit'].format(admin=ADMIN_USERNAME),
            reply_markup=get_back_keyboard(lang=lang)
        )
        return
    
    await query.edit_message_text(
        f"🔍 Ищу свободный тег ({length} букв)...\n\nПодожди 1 сек.",
        reply_markup=None
    )
    
    # Проверяем кеш
    cached = get_cached_free_tag(length=length, min_stars=10)
    if cached:
        tag = cached['tag']
        stars = cached['stars']
        readable = cached['readable_score']
        remove_cached_tag(tag)
        
        save_found_tag(user_id, tag, length, stars, readable)
        
        text = f"<b>✅ НИК НАЙДЕН!</b>\n\n@{tag}\n{length} букв\n⭐ {stars} ⭐\n✅ Свободен\n\n🔗 t.me/{tag}"
