async def handle_promo_input(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.user_data.get('awaiting_promo'):
        return
    
    user_id = update.effective_user.id
    code = update.message.text.strip().upper()
    user = get_user(user_id)
    lang = user['language']
    t = LANG[lang]
    
    with get_db_connection() as conn:
        c = conn.cursor()
        c.execute('SELECT type, value, max_uses, used FROM promocodes WHERE code = ?', (code,))
        row = c.fetchone()
        
        if not row:
            await update.message.reply_text(t['promo_invalid'])
            context.user_data['awaiting_promo'] = False
            return
        
        ptype, value, max_uses, used = row
        
        if used >= max_uses:
            await update.message.reply_text(t['promo_invalid'])
            context.user_data['awaiting_promo'] = False
            return
        
        c.execute('SELECT 1 FROM promo_used WHERE user_id = ? AND code = ?', (user_id, code))
        if c.fetchone():
            await update.message.reply_text(t['promo_used'])
            context.user_data['awaiting_promo'] = False
            return
        
        if ptype == 'requests':
            c.execute('UPDATE users SET daily_requests = daily_requests + ? WHERE user_id = ?', (value, user_id))
            reward = f"+{value} запросов"
        else:
            until = (datetime.datetime.now() + datetime.timedelta(days=value)).strftime("%Y-%m-%d")
            c.execute('UPDATE users SET premium_level = 1, premium_until = ? WHERE user_id = ?', (until, user_id))
            reward = f"Премиум на {value} дн."
        
        c.execute('UPDATE promocodes SET used = used + 1 WHERE code = ?', (code,))
        c.execute('INSERT INTO promo_used (user_id, code) VALUES (?, ?)', (user_id, code))
        conn.commit()
    
    await update.message.reply_text(t['promo_success'].format(reward=reward))
    context.user_data['awaiting_promo'] = False

