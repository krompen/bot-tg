async def worker_check_tags():
    """Фоновый воркер для проверки тегов"""
    while True:
        try:
            tag, length, future = await check_queue.get()
            
            if tag in checked_cache:
                cache_time, free = checked_cache[tag]
                if time.time() - cache_time < CACHE_TTL:
                    future.set_result(free)
                    continue
            
            if not telethon_client.is_connected():
                await telethon_client.connect()
            
            free = await check_username_free(telethon_client, tag)
            checked_cache[tag] = (time.time(), free)
            
            if free:
                stars, readable = calculate_tag_score(tag)
                add_free_tag_to_cache(tag, length, stars, readable)
            
            future.set_result(free)
            await asyncio.sleep(CHECK_DELAY)
            
        except Exception as e:
            logger.error(f"Worker error: {e}")
            future.set_result(False)

async def background_tag_generator():
    """Фоновый сбор свободных тегов"""
    while True:
        try:
            if not telethon_client.is_connected():
                await telethon_client.connect()
            
            for _ in range(5):
                length = random.choice([5, 6])
                tag = generate_tag(length)
                
                if tag in checked_cache:
                    cache_time, free = checked_cache[tag]
                    if time.time() - cache_time < CACHE_TTL:
                        continue
                
                free = await check_username_free(telethon_client, tag)
                checked_cache[tag] = (time.time(), free)
                
                if free:
                    stars, readable = calculate_tag_score(tag)
                    add_free_tag_to_cache(tag, length, stars, readable)
                    logger.info(f"Found free tag: @{tag}")
                
                await asyncio.sleep(CHECK_DELAY)
            
            await asyncio.sleep(30)
            
        except Exception as e:
            logger.error(f"Generator error: {e}")
            await asyncio.sleep(60)

async def trap_checker():
    """Проверка ловушек"""
    while True:
        try:
            with get_db_connection() as conn:
                c = conn.cursor()
                c.execute('SELECT id, user_id, tag FROM traps WHERE notified = 0 LIMIT 50')
                traps = c.fetchall()
            
            if traps and not telethon_client.is_connected():
                await telethon_client.connect()
            
            for trap_id, user_id, tag in traps:
                free = await check_username_free(telethon_client, tag)
                if free:
                    app = Application.builder().token(BOT_TOKEN).build()
                    await app.bot.send_message(
                        user_id,
                        f"🎯 ЛОВУШКА СРАБОТАЛА!\n\nТег @{tag} теперь свободен!\n\nБыстрее забирай: t.me/{tag}"
                    )
                    with get_db_connection() as conn:
                        conn.execute('UPDATE traps SET notified = 1 WHERE id = ?', (trap_id,))
                        conn.commit()
                    logger.info(f"Trap triggered: @{tag} for user {user_id}")
            
            await asyncio.sleep(TRAP_CHECK_INTERVAL)
            
        except Exception as e:
            logger.error(f"Trap checker error: {e}")
            await asyncio.sleep(60)

