def get_db_connection():
    return sqlite3.connect(DB_NAME, timeout=30)

def get_setting(key: str) -> Optional[str]:
    with get_db_connection() as conn:
        c = conn.cursor()
        c.execute('SELECT value FROM settings WHERE key = ?', (key,))
        row = c.fetchone()
        return row[0] if row else None

def set_setting(key: str, value: str):
    with get_db_connection() as conn:
        conn.execute('UPDATE settings SET value = ? WHERE key = ?', (value, key))
        conn.commit()

def get_user(user_id: int, username: str = "", first_name: str = "") -> Dict:
    with get_db_connection() as conn:
        c = conn.cursor()
        c.execute('''SELECT user_id, username, first_name, language, premium_level, premium_until, 
                    daily_requests, last_reset, total_requests, total_found, is_banned,
                    referrer_id, referral_bonus, bonus_claimed
                    FROM users WHERE user_id = ?''', (user_id,))
        row = c.fetchone()
        
        if not row:
            today = datetime.datetime.now().strftime("%Y-%m-%d")
            c.execute('''INSERT INTO users (user_id, username, first_name, last_reset) 
                        VALUES (?, ?, ?, ?)''', (user_id, username, first_name, today))
            conn.commit()
            return get_user(user_id, username, first_name)
        
        user = {
            'user_id': row[0], 'username': row[1], 'first_name': row[2], 'language': row[3] or 'ru',
            'premium_level': row[4], 'premium_until': row[5], 'daily_requests': row[6],
            'last_reset': row[7], 'total_requests': row[8], 'total_found': row[9],
            'is_banned': row[10], 'referrer_id': row[11], 'referral_bonus': row[12] or 0,
            'bonus_claimed': row[13]
        }
        
        if user['is_banned']:
            return user
        
        if user['premium_until']:
            try:
                until = datetime.datetime.strptime(user['premium_until'], "%Y-%m-%d")
                if until < datetime.datetime.now():
                    c.execute('UPDATE users SET premium_level = 0, premium_until = NULL WHERE user_id = ?', (user_id,))
                    conn.commit()
                    user['premium_level'] = 0
                    user['premium_until'] = None
            except:
                pass
        
        today = datetime.datetime.now().strftime("%Y-%m-%d")
        if user['last_reset'] != today:
            base_requests = FREE_REQUESTS_PER_DAY + user['referral_bonus']
            c.execute('UPDATE users SET daily_requests = ?, last_reset = ? WHERE user_id = ?', 
                     (base_requests, today, user_id))
            conn.commit()
            user['daily_requests'] = base_requests
            user['last_reset'] = today
        
        return user

def use_request(user_id: int) -> Tuple[bool, str]:
    user = get_user(user_id)
    if user['is_banned']:
        return False, "banned"
    if user['premium_level'] >= 1:
        return True, "premium"
    if user['daily_requests'] <= 0:
        return False, "limit"
    
    with get_db_connection() as conn:
        conn.execute('''UPDATE users SET daily_requests = daily_requests - 1, 
                       total_requests = total_requests + 1 WHERE user_id = ?''', (user_id,))
        conn.commit()
    return True, "ok"

