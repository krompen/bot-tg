async def search_tag(query, length: int, user_id: int, lang: str):
    t = LANG[lang]
    can_request, reason = use_request(user_id)
    
    if not can_request:
        await query.edit_message_text(
            t['limit'].format(admin=ADMIN_USERNAME),
            reply_markup=get_back_keyboard(lang=lang)
        )
        return
    
    await query.edit_message_text(t['searching'].format(length=length))
    
    cached = get_cached_free_tag(length=length)
    if cached:
        tag = cached['tag']
        stars = cached['stars']
        remove_cached_tag(tag)
        save_found_tag(user_id, tag, length, stars)
        
        text = f"<b>{t['found']}</b>\n\n@{tag}\n{length} букв\n⭐ {stars} ⭐\n✅ Свободен\n\n🔗 t.me/{tag}"
        await query.edit_message_text(
            text,
            parse_mode=ParseMode.HTML,
            reply_markup=InlineKeyboardMarkup([
                [InlineKeyboardButton(f"🔎 {length} БУКВ", callback_data=f'find_{length}')],
                [InlineKeyboardButton(t['back'], callback_data='back_main')]
            ]),
            disable_web_page_preview=True
        )
        return
    
    found = False
    attempts = 0
    tag = ""
    stars = 0
    
    await telethon_client.connect()
    
    while not found and attempts < 50:
        tag = generate_tag(length)
        free = await check_username_free(tag)
        attempts += 1
        
        if free:
            stars = calculate_tag_score(tag)
            found = True
            add_free_tag_to_cache(tag, length, stars)
        await asyncio.sleep(1.5)
    
    if found:
        save_found_tag(user_id, tag, length, stars)
        text = f"<b>{t['found']}</b>\n\n@{tag}\n{length} букв\n⭐ {stars} ⭐\n✅ Свободен\n\n🔗 t.me/{tag}"
    else:
        text = f"<b>{t['not_found']}</b>\n\nПопробуй еще раз!"
    
    await query.edit_message_text(
        text,
        parse_mode=ParseMode.HTML,
        reply_markup=InlineKeyboardMarkup([
            [InlineKeyboardButton(f"🔎 {length} БУКВ", callback_data=f'find_{length}')],
            [InlineKeyboardButton(t['back'], callback_data='back_main')]
        ]),
        disable_web_page_preview=True
    )

