async def search_tag(query, length: int, user_id: int, lang: str):
    t = LANG[lang]
    can_request, reason = use_request(user_id)
    
    if not can_request:
        await edit_message_safe(query, t['limit'].format(admin=ADMIN_USERNAME), reply_markup=get_back_keyboard(lang=lang))
        return
    
    await edit_message_safe(query, t['searching'].format(length=length))
    
    # Получаем список уже найденных тегов пользователя
    with get_db_connection() as conn:
        c = conn.cursor()
        c.execute('SELECT tag FROM user_found_tags WHERE user_id = ?', (user_id,))
        exclude_tags = [row[0] for row in c.fetchall()]
    
    # Проверяем кеш с исключением уже найденных
    cached = get_cached_free_tag(length=length, exclude_tags=exclude_tags)
    if cached:
        tag = cached['tag']
        stars = cached['stars']
        remove_cached_tag(tag)
        save_found_tag(user_id, tag, length, stars)
        
        text = f"<b>{t['found']}</b>\n\n@{tag}\n{length} букв\n⭐ {stars} ⭐\n✅ Свободен\n\nhttps://t.me/{tag}"
        keyboard = InlineKeyboardMarkup([
            [InlineKeyboardButton(f"🔎 {length} БУКВ", callback_data=f'find_{length}')],
            [InlineKeyboardButton(t['back'], callback_data='back_main')]
        ])
        await edit_message_safe(query, text, reply_markup=keyboard, disable_web_page_preview=True)
        return
    
    found = False
    attempts = 0
    tag = ""
    stars = 0
    
    try:
        if not telethon_client.is_connected():
            await telethon_client.connect()
        
        while not found and attempts < 40:
            tag = generate_tag(length)
            
            # Пропускаем уже найденные
            if tag in exclude_tags:
                attempts += 1
                continue
                
            free = await check_username_free(tag)
            attempts += 1
            
            if free:
                stars = calculate_tag_score(tag)
                found = True
                add_free_tag_to_cache(tag, length, stars)
            await asyncio.sleep(0.8)
    except Exception as e:
        logger.error(f"Search error: {e}")
    
    if found:
        save_found_tag(user_id, tag, length, stars)
        text = f"<b>{t['found']}</b>\n\n@{tag}\n{length} букв\n⭐ {stars} ⭐\n✅ Свободен\n\nhttps://t.me/{tag}"
    else:
        text = f"<b>{t['not_found']}</b>"
    
    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton(f"🔎 {length} БУКВ", callback_data=f'find_{length}')],
        [InlineKeyboardButton(t['back'], callback_data='back_main')]
    ])
    
    await edit_message_safe(query, text, reply_markup=keyboard, disable_web_page_preview=True)

