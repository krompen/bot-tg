async def confirm_payment_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    
    if not context.args:
        await update.message.reply_text("/confirm ID")
        return
    
    user_id = int(context.args[0])
    
    with get_db_connection() as conn:
        c = conn.cursor()
        c.execute('''SELECT id, days FROM payments 
                    WHERE user_id = ? AND status = 'pending' ORDER BY id DESC LIMIT 1''', (user_id,))
        row = c.fetchone()
        
        if not row:
            await update.message.reply_text("❌ Нет ожидающих платежей")
            return
        
        payment_id, days = row
        
        until = (datetime.datetime.now() + datetime.timedelta(days=days)).strftime("%Y-%m-%d")
        
        c.execute('''UPDATE users SET premium_level = 1, premium_until = ? 
                    WHERE user_id = ?''', (until, user_id))
        c.execute('''UPDATE payments SET status = 'confirmed', confirmed_at = ?, confirmed_by = ? 
                    WHERE id = ?''', (datetime.datetime.now().isoformat(), ADMIN_ID, payment_id))
        conn.commit()
    
    await update.message.reply_text(f"✅ Платёж пользователя {user_id} подтверждён!")
    
    try:
        await context.bot.send_message(
            user_id,
            f"✅ <b>ПЛАТЁЖ ПОДТВЕРЖДЁН!</b>\n\n💎 Премиум активирован на {days} дн.\n📅 До: {until}",
            parse_mode=ParseMode.HTML
        )
    except:
        pass

async def answer_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    
    if len(context.args) < 2:
        await update.message.reply_text("/answer ID_ticket текст")
        return
    
    ticket_id = int(context.args[0])
    answer = " ".join(context.args[1:])
    
    with get_db_connection() as conn:
        c = conn.cursor()
        c.execute('SELECT user_id FROM tickets WHERE id = ?', (ticket_id,))
        row = c.fetchone()
        
        if row:
            c.execute('''UPDATE tickets SET status = 'closed', answer = ?, answered_at = ? 
                        WHERE id = ?''', (answer, datetime.datetime.now().isoformat(), ticket_id))
            conn.commit()
            
            await context.bot.send_message(row[0], f"📨 <b>ОТВЕТ НА ТИКЕТ #{ticket_id}</b>\n\n{answer}", parse_mode=ParseMode.HTML)
            await update.message.reply_text(f"✅ Ответ отправлен в тикет #{ticket_id}")
        else:
            await update.message.reply_text("❌ Тикет не найден")

async def add_tag_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    
    if len(context.args) < 2:
        await update.message.reply_text("/addtag @тег цена [описание]")
        return
    
    tag = context.args[0].replace('@', '').lower()
    price = float(context.args[1])
    desc = " ".join(context.args[2:]) if len(context.args) > 2 else ""
    
    with get_db_connection() as conn:
        conn.execute('''INSERT OR REPLACE INTO shop_tags (tag, price, description, seller_id, status) 
                       VALUES (?, ?, ?, ?, 'available')''', (tag, price, desc, ADMIN_ID))
        conn.commit()
    
    await update.message.reply_text(f"✅ Тег @{tag} добавлен в магазин за ${price:.2f}")

async def broadcast_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    
    if not context.args:
        await update.message.reply_text("/broadcast текст")
        return
    
    text = " ".join(context.args)
    
    with get_db_connection() as conn:
        users = conn.execute('SELECT user_id FROM users WHERE is_banned = 0').fetchall()
    
    sent = 0
    for (user_id,) in users:
        try:
            await context.bot.send_message(user_id, f"📢 <b>РАССЫЛКА</b>\n\n{text}", parse_mode=ParseMode.HTML)
            sent += 1
            await asyncio.sleep(0.05)
        except:
            pass
    
    await update.message.reply_text(f"✅ Рассылка отправлена: {sent}/{len(users)}")

async def create_promocode_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    
    if len(context.args) < 4:
        await update.message.reply_text("/create_code CODE тип(requests/premium) значение макс_исп")
        return
    
    code = context.args[0].upper()
    ptype = context.args[1]
    value = int(context.args[2])
    max_uses = int(context.args[3])
    
    if ptype not in ['requests', 'premium']:
        await update.message.reply_text("❌ Тип: requests или premium")
        return
    
    with get_db_connection() as conn:
        conn.execute('''INSERT OR REPLACE INTO promocodes (code, type, value, max_uses, created_by) 
                       VALUES (?, ?, ?, ?, ?)''', (code, ptype, value, max_uses, ADMIN_ID))
        conn.commit()
    
    await update.message.reply_text(f"✅ Промокод {code} создан: {value} {ptype}, использований: {max_uses}")

