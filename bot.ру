async def answer_ticket(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        await update.message.reply_text("⛔ Нет прав")
        return
    if len(context.args) < 2:
        await update.message.reply_text("❌ /answer <id> <текст>")
        return
    
    ticket_id = int(context.args[0])
    answer = " ".join(context.args[1:])
    
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    c.execute('SELECT user_id FROM tickets WHERE id = ?', (ticket_id,))
    row = c.fetchone()
    if row:
        c.execute('UPDATE tickets SET status = "closed", admin_answer = ? WHERE id = ?', (answer, ticket_id))
        conn.commit()
        await context.bot.send_message(row[0], f"📬 **Ответ на тикет #{ticket_id}**\n\n{answer}")
        await update.message.reply_text(f"✅ Ответ отправлен в тикет #{ticket_id}")
    else:
        await update.message.reply_text("❌ Тикет не найден")
    conn.close()

