def get_cached_free_tag(length: Optional[int] = None, exclude_tags: list = None) -> Optional[Dict]:
    with get_db_connection() as conn:
        c = conn.cursor()
        if length:
            c.execute('''SELECT tag, length, stars FROM free_tags_cache 
                        WHERE length = ? ORDER BY stars DESC LIMIT 50''', (length,))
        else:
            c.execute('''SELECT tag, length, stars FROM free_tags_cache 
                        ORDER BY stars DESC LIMIT 50''')
        rows = c.fetchall()
        if rows:
            if exclude_tags:
                for row in rows:
                    if row[0] not in exclude_tags:
                        return {'tag': row[0], 'length': row[1], 'stars': row[2]}
            return {'tag': rows[0][0], 'length': rows[0][1], 'stars': rows[0][2]}
        return None

