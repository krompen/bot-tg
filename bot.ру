    code = context.args[0].upper()
    ptype = context.args[1]
    value = int(context.args[2])
    max_uses = int(context.args[3])
    
    with get_db_connection() as conn:
        conn.execute('INSERT OR REPLACE INTO promocodes (code, type, value, max_uses) VALUES (?, ?, ?, ?)',
                    (code, ptype, value, max_uses))
