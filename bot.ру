async def addtag_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    if len(context.args) < 2:
        await update.message.reply_text("/addtag @тег цена [описание]")
        return
    
    tag = context.args[0].replace('@', '').lower()
    price = float(context.args[1])
    desc = " ".join(context.args[2:]) if len(context.args) > 2 else ""
    
    with get_db_connection() as conn:
        conn.execute('INSERT OR REPLACE INTO shop (tag, price, description, seller_id) VALUES (?, ?, ?, ?)',
                    (tag, price, desc, ADMIN_ID))
        conn.commit()
    
    await update.message.reply_text(f"✅ @{tag} добавлен в магазин за ${price:.2f}")

async def create_code_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    if len(context.args) < 4:
        await update.message.reply_text("/create_code CODE тип requests/premium значение макс_исп")
