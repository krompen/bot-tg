def init_db():
    with sqlite3.connect(DB_NAME) as conn:
        conn.execute("PRAGMA journal_mode=WAL")
        conn.execute("PRAGMA busy_timeout=30000")
        c = conn.cursor()
        
        c.execute('''CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            first_name TEXT,
            language TEXT DEFAULT 'ru',
            premium_level INTEGER DEFAULT 0,
            premium_until TEXT,
            daily_requests INTEGER DEFAULT 5,
            last_reset TEXT,
            total_requests INTEGER DEFAULT 0,
            total_found INTEGER DEFAULT 0,
            is_banned INTEGER DEFAULT 0,
            referrer_id INTEGER,
            referral_bonus INTEGER DEFAULT 0,
            bonus_claimed INTEGER DEFAULT 0
        )''')
        
        c.execute('''CREATE TABLE IF NOT EXISTS found_tags (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            tag TEXT,
            length INTEGER,
            stars INTEGER
        )''')
        
        c.execute('''CREATE TABLE IF NOT EXISTS free_tags_cache (
            tag TEXT PRIMARY KEY,
            length INTEGER,
            stars INTEGER
        )''')
        
        c.execute('''CREATE TABLE IF NOT EXISTS traps (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            tag TEXT,
            notified INTEGER DEFAULT 0
        )''')
        
        c.execute('''CREATE TABLE IF NOT EXISTS tickets (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            username TEXT,
            question TEXT,
            status TEXT DEFAULT 'open'
        )''')
        
        c.execute('''CREATE TABLE IF NOT EXISTS settings (
            key TEXT PRIMARY KEY,
            value TEXT
        )''')
        
        c.execute('''CREATE TABLE IF NOT EXISTS shop (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            tag TEXT UNIQUE,
            price REAL,
            description TEXT,
            seller_id INTEGER,
            status TEXT DEFAULT 'available'
        )''')
        
        c.execute('''CREATE TABLE IF NOT EXISTS user_found_tags (
            user_id INTEGER,
            tag TEXT,
            PRIMARY KEY (user_id, tag)
        )''')
        
        c.execute('INSERT OR IGNORE INTO settings (key, value) VALUES ("header_image_id", "")')
        
        conn.commit()
    logger.info("База данных инициализирована")

init_db()

