# ========== БАЗА ДАННЫХ ==========
def init_db():
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS users (
        user_id INTEGER PRIMARY KEY,
        username TEXT,
        premium_level INTEGER DEFAULT 0,
        premium_until TEXT,
        daily_requests INTEGER DEFAULT 5,
        last_reset TEXT,
        total_requests INTEGER DEFAULT 0,
        is_banned INTEGER DEFAULT 0
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS found_tags (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        tag TEXT,
        found_date TEXT
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS tickets (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        username TEXT,
        question TEXT,
        status TEXT DEFAULT 'open',
        created_at TEXT,
        admin_answer TEXT
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS free_tags_cache (
        tag TEXT PRIMARY KEY,
        found_date TEXT
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS promocodes (
        code TEXT PRIMARY KEY,
        level INTEGER,
        days INTEGER,
        used_count INTEGER DEFAULT 0,
        max_uses INTEGER DEFAULT 1
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS traps (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        target_tag TEXT,
        status TEXT DEFAULT 'waiting'
    )''')
    conn.commit()
    conn.close()

init_db()

# ========== ГЕНЕРАЦИЯ ЧИТАЕМЫХ ТЕГОВ ==========
CONSONANTS = "bcdfghjklmnpqrstvwxz"
VOWELS = "aeiou"

def generate_tag(length=5):
    tag = ""
    for i in range(length):
        if i % 2 == 0:
            tag += random.choice(CONSONANTS)
        else:
            tag += random.choice(VOWELS)
    return tag

# ========== ПРОВЕРКА ТЕГА ==========
checked_cache = {}
CACHE_TIME = 3600

async def is_tag_free(tag):
    if tag in checked_cache:
        cache_time, free = checked_cache[tag]
        if time.time() - cache_time < CACHE_TIME:
            return free

    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(f"https://t.me/{tag}", timeout=10) as resp:
                html = await resp.text()
                if "Send Message" in html or "If you have Telegram" in html:
                    free = False
                else:
                    free = True
                checked_cache[tag] = (time.time(), free)
                return free
    except:
        return False

# ========== РАБОТА С БАЗОЙ ==========
def get_user(user_id, username=""):
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    c.execute('SELECT user_id, premium_level, premium_until, daily_requests, last_reset, total_requests, is_banned FROM users WHERE user_id = ?', (user_id,))
    user = c.fetchone()
    conn.close()
    
    if not user:
        conn = sqlite3.connect(DB_NAME, timeout=10)
        c = conn.cursor()
        today = datetime.datetime.now().strftime("%Y-%m-%d")
        c.execute('INSERT INTO users (user_id, username, last_reset) VALUES (?, ?, ?)', (user_id, username, today))
        conn.commit()
        conn.close()
        return get_user(user_id, username)
    
    if user[6] == 1:
        return user
    
    if user[2]:
        try:
            premium_until = datetime.datetime.strptime(user[2], "%Y-%m-%d")
            if premium_until < datetime.datetime.now():
                conn = sqlite3.connect(DB_NAME, timeout=10)
                c = conn.cursor()
                c.execute('UPDATE users SET premium_level = 0, premium_until = NULL WHERE user_id = ?', (user_id,))
                conn.commit()
                conn.close()
                return get_user(user_id, username)
        except:
            pass
    
    today = datetime.datetime.now().strftime("%Y-%m-%d")
    if user[4] != today:
        conn = sqlite3.connect(DB_NAME, timeout=10)
        c = conn.cursor()
        c.execute('UPDATE users SET daily_requests = 5, last_reset = ? WHERE user_id = ?', (today, user_id))
        conn.commit()
        conn.close()
        return get_user(user_id, username)
    
    return user

def use_request(user_id):
    user = get_user(user_id)
    if not user:
        return False
    if user[6] == 1:
        return False
    if user[1] >= 1:
        return True
    if user[3] <= 0:
        return False
    
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    c.execute('UPDATE users SET daily_requests = daily_requests - 1, total_requests = total_requests + 1 WHERE user_id = ?', (user_id,))
    conn.commit()
    conn.close()
    return True

def get_requests_left(user_id):
    user = get_user(user_id)
    if not user:
        return "5"
    if user[6] == 1:
        return "Забанен"
    if user[1] >= 1:
        return "∞"
    return str(user[3])

def save_free_tag(tag):
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    c.execute('INSERT OR IGNORE INTO free_tags_cache (tag, found_date) VALUES (?, ?)', (tag, now))
    conn.commit()
    conn.close()

def get_cached_free_tag():
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    c.execute('SELECT tag FROM free_tags_cache ORDER BY RANDOM() LIMIT 1')
    row = c.fetchone()
    conn.close()
    return row[0] if row else None

def remove_cached_tag(tag):
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    c.execute('DELETE FROM free_tags_cache WHERE tag = ?', (tag,))
    conn.commit()
    conn.close()

def save_found_tag(user_id, tag):
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    c.execute('INSERT INTO found_tags (user_id, tag, found_date) VALUES (?, ?, ?)', (user_id, tag, now))
    conn.commit()
    conn.close()

def set_premium(user_id, days):
    conn = sqlite3.connect(DB_NAME, timeout=10)
    c = conn.cursor()
    until = (datetime.datetime.now() + datetime.timedelta(days=days)).strftime("%Y-%m-%d")
    c.execute('UPDATE users SET premium_level = 1, premium_until = ? WHERE user_id = ?', (until, user_id))
    conn.commit()
    conn.close()

# ========== ПОИСК ТЕГА ==========
async def find_tag(update: Update, context: ContextTypes.DEFAULT_TYPE, from_callback=False):
    user_id = update.effective_user.id
    user = get_user(user_id, update.effective_user.username or "")
    
    if not use_request(user_id):
        left = get_requests_left(user_id)
        msg = f"❌ Лимит: {left}/день. Купи премиум у @{ADMIN_USERNAME}"
        if from_callback:
            await update.edit_message_text(msg)
        else:
            await update.message.reply_text(msg)
        return
    
    if from_callback:
        msg = await update.edit_message_text("🔍 Ищу тег...")
    else:
        msg = await update.message.reply_text("🔍 Ищу тег...")
    
    cached = get_cached_free_tag()
    if cached and await is_tag_free(cached):
        remove_cached_tag(cached)
        save_found_tag(user_id, cached)
        left = get_requests_left(user_id)
        await msg.edit_text(f"✅ **Найден тег!**\n\n📝 @{cached}\n\n🔍 Осталось: {left}")
        return
    
    found = False
    attempts = 0
    tag = ""
    
    while not found and attempts < 200:
        length = random.choice([5, 6])
        tag = generate_tag(length)
        found = await is_tag_free(tag)
        attempts += 1
    
    if found:
        save_free_tag(tag)
        save_found_tag(user_id, tag)
        left = get_requests_left(user_id)
        await msg.edit_text(f"✅ **Найден тег!**\n\n📝 @{tag}\n\n🔍 Осталось: {left}")
    else:
        await msg.edit_text("❌ Не нашел свободный тег. Попробуй еще раз.")

# ========== ФОНОВЫЙ СБОР ==========
async def collect_tags():
    while True:
        for _ in range(3):
            tag = generate_tag(random.choice([5, 6]))
            if await is_tag_free(tag):
                save_free_tag(tag)
        await asyncio.sleep(60)

