def add_free_tag_to_cache(tag: str, length: int, stars: int):
    with get_db_connection() as conn:
        conn.execute('''INSERT OR IGNORE INTO free_tags_cache (tag, length, stars) 
                       VALUES (?, ?, ?)''', (tag, length, stars))
