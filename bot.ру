async def setup_commands(app: Application):
    commands = [
        BotCommand("start", "Запуск бота"),
        BotCommand("info", "Информация"),
        BotCommand("promo", "Активировать промокод"),
    ]
    await app.bot.set_my_commands(commands)

async def on_startup(app: Application):
    logger.info("Запуск Telethon...")
    try:
        await telethon_client.connect()
        if await telethon_client.is_user_authorized():
            logger.info("✅ Telethon авторизован!")
            me = await telethon_client.get_me()
            logger.info(f"👤 Аккаунт: @{me.username or me.first_name}")
        else:
            logger.error("❌ Telethon НЕ авторизован!")
    except Exception as e:
        logger.error(f"Ошибка Telethon: {e}")
    logger.info("Бот запущен!")

def main():
    app = Application.builder().token(BOT_TOKEN).build()
    
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("promo", lambda u, c: c.user_data.update({'awaiting_promo': True}) or u.message.reply_text("🎁 Введите промокод:")))
    app.add_handler(CommandHandler("info", lambda u, c: u.message.reply_text(f"ℹ️ TEG SEARCH by ciwige\n\nКанал: {CHANNEL_LINK}\nАдмин: {ADMIN_USERNAME}")))
    
    app.add_handler(CommandHandler("ban", ban_cmd))
    app.add_handler(CommandHandler("unban", unban_cmd))
    app.add_handler(CommandHandler("premium", premium_cmd))
    app.add_handler(CommandHandler("reset", reset_cmd))
    app.add_handler(CommandHandler("answer", answer_cmd))
    app.add_handler(CommandHandler("addtag", addtag_cmd))
    app.add_handler(CommandHandler("create_code", create_code_cmd))
    
    app.add_handler(CallbackQueryHandler(button_handler))
    
    app.add_handler(MessageHandler(filters.Regex(r'^/buy_\d+$'), handle_buy_command))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_trap_input))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_ticket))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_broadcast_input))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_promo_input))
    app.add_handler(MessageHandler(filters.PHOTO & filters.User(user_id=ADMIN_ID), set_header_image))
    
    app.post_init = setup_commands
    
    print("Бот запущен!")
    app.run_polling(drop_pending_updates=True)

if __name__ == "__main__":
