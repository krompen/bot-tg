        try:
            ref_id = int(args[0])
            if ref_id != user.id:
                user_data = get_user(user.id, user.username or "", user.first_name or "")
                if not user_data.get('referrer_id'):
                    with get_db_connection() as conn:
                        conn.execute('UPDATE users SET referrer_id = ? WHERE user_id = ?', (ref_id, user.id))
                        conn.execute('UPDATE users SET referral_bonus = referral_bonus + 1 WHERE user_id = ?', (ref_id,))
                        conn.commit()
        except:
            pass
    
    user_data = get_user(user.id, user.username or "", user.first_name or "")
    await send_main_menu(update, user.id, user_data['language'])

